{
  "name": "smart-csv-mapper-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . && prettier --check src",
    "format": "prettier --write src",
    "typecheck": "tsc -b",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "gen:api": "cd ../backend && uv run python -c \"import json; from smart_csv_mapper.main import create_app; from smart_csv_mapper.config import Settings; print(json.dumps(create_app(Settings(llm_provider='fake', audit_db_path=':memory:')).openapi()))\" > ../frontend/src/api/openapi.json && cd ../frontend && npx -y openapi-typescript@7.13.0 src/api/openapi.json -o src/api/schema.d.ts && rm src/api/openapi.json"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^27.0.1",
    "msw": "^2.15.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=11"
  },
  "allowScripts": {
    "msw": false
  }
}
