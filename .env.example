# LLM provider: ollama (default, free, local) | claude (optional, needs a key)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
OLLAMA_URL=http://localhost:11434

# Only if LLM_PROVIDER=claude
ANTHROPIC_API_KEY=

# Optional: use Redis for the AI-transform cache (in-memory if empty)
REDIS_URL=

# Upload limits
MAX_UPLOAD_MB=10
MAX_ROWS=50000
